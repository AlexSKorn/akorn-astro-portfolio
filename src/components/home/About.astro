---
import { info } from "@data";
---

<section id="about" class="py-10" aria-labelledby="about-title">
	<div class="flex items-center mb-8">
		<div class="section-title-bar mr-4"></div>
		<h2 id="about-title" class="text-2xl font-semibold text-gray-800 dark:text-gray-100">
			ABOUT ME
		</h2>
	</div>

	<p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed max-w-5xl mb-10">
		{info.about}
	</p>

	<h3 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4 font-outfit">
		What I Bring
	</h3>
	<ul class="md:columns-2 gap-x-10">
		{
			info.strengths.map((strength) => (
				<li class="flex items-start mb-3 break-inside-avoid">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="text-blue-500 dark:text-blue-400 mr-3 mt-0.5 shrink-0"
						aria-hidden="true"
					>
						<polyline points="20,6 9,17 4,12" />
					</svg>
					<span class="text-gray-700 dark:text-gray-300">
						<strong class="text-gray-900 dark:text-gray-100">{strength.title}:</strong>{" "}
						{strength.detail}
					</span>
				</li>
			))
		}
	</ul>
</section>
