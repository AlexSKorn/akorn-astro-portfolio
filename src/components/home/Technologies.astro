---
import type { ITechnologies, ITechnology } from "@types";

const { title, technologies } = Astro.props as ITechnologies;

// Group technologies by their category, preserving the order categories first appear in info.ts
const groupedTechnologies = technologies.reduce<Record<string, ITechnology[]>>(
	(groups, tech) => {
		(groups[tech.category] ??= []).push(tech);
		return groups;
	},
	{},
);
---

<section
	id="technologies"
	class="flex items-start justify-between flex-col lg:flex-row text-gray-800 dark:text-gray-200 my-10"
	aria-labelledby="technologies-title"
>
	<h2
		id="technologies-title"
		class="w-full lg:w-[15rem] mb-8 lg:mb-0 text-2xl font-semibold text-gray-800 dark:text-gray-100"
	>
		{title}
	</h2>
	<dl class="w-full lg:flex-1 grid sm:grid-cols-2 gap-x-8 gap-y-6">
		{
			Object.entries(groupedTechnologies).map(([category, techs]) => (
				<div>
					<dt class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2.5 uppercase tracking-wider">
						{category}
					</dt>
					<dd>
						<ul class="flex flex-wrap gap-2" role="list">
							{techs.map((tech) => (
								<li class="px-2.5 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 text-xs font-medium rounded-full border border-blue-200 dark:border-blue-700">
									{tech.name}
								</li>
							))}
						</ul>
					</dd>
				</div>
			))
		}
	</dl>
</section>
