---
import type { IExperiences } from "@types";

const { id, title, details, detailedCount = details.length } = Astro.props as IExperiences;

const detailed = details.slice(0, detailedCount);
const earlier = details.slice(detailedCount);
const formatDates = (start: string, end: string) => (start ? `${start} - ${end}` : "");
---

<section
	id={id}
	class="flex items-start justify-between flex-col lg:flex-row text-gray-800 dark:text-gray-200 my-10"
	aria-labelledby={`${id}-title`}
>
	<h2
		id={`${id}-title`}
		class="w-full lg:w-[15rem] mb-8 lg:mb-0 text-2xl font-semibold text-gray-800 dark:text-gray-100"
	>
		{title}
	</h2>
	<div class="w-full lg:flex-1 relative">
		<!-- Timeline connector line -->
		<div class="absolute left-0 top-2 bottom-2 w-0.5 bg-linear-to-b from-blue-400 via-purple-500 to-pink-400 rounded-full hidden lg:block" aria-hidden="true"></div>
		
		{
			detailed.map((item) => (
				<div class="mb-10 last:mb-0 lg:pl-8 relative">
					<!-- Timeline dot -->
					<div class="timeline-dot absolute -left-[5px] top-2 hidden lg:block" aria-hidden="true"></div>
					
					<div class="space-y-4">
						<div class="flex justify-between items-start flex-col sm:flex-row gap-1 sm:gap-3">
							<div class="flex-1">
								<h3 class="text-xl font-semibold text-gray-800 dark:text-gray-100 font-outfit leading-tight">
									{item.name}
								</h3>
								<p class="text-blue-600 dark:text-blue-400 font-medium mt-1">
									{item.location}
								</p>
							</div>
							{item.startDate && (
								<p class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap sm:mt-1.5">
									{formatDates(item.startDate, item.endDate)}
								</p>
							)}
						</div>

						{item.description.length > 0 && (
						<ul class="space-y-2.5 mt-4">
							{item.description.map((desc) => (
								<li class="text-gray-600 dark:text-gray-300 flex items-start leading-relaxed">
									<span class="text-blue-500 dark:text-blue-400 mr-3 mt-1.5 text-xs shrink-0" aria-hidden="true">
										●
									</span>
									<span class="flex-1">{desc.replace(/^-\s*/, "")}</span>
								</li>
							))}
						</ul>
						)}

						{/* Technologies for each job: one quiet, dot-separated line */}
						{item.skills && item.skills.length > 0 && (
							<div class="mt-5 pt-4 border-t border-gray-200 dark:border-gray-700/60">
								<h4 class="sr-only">Key technologies</h4>
								<ul class="flex flex-wrap text-sm leading-relaxed" role="list">
									{item.skills.map((skill) => (
										<li class="text-gray-500 dark:text-gray-400 after:content-['·'] after:mx-2 after:text-gray-300 dark:after:text-gray-600 last:after:content-none">
											{skill}
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</div>
			))
		}

		{
			earlier.length > 0 && (
				<div class="mt-10 lg:pl-8 relative">
					<div class="timeline-dot absolute -left-[5px] top-1 hidden lg:block" aria-hidden="true" />
					<h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-4 uppercase tracking-wider">
						Earlier Roles
					</h3>
					<ul class="space-y-3">
						{earlier.map((item) => (
							<li class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
								<span>
									<span class="font-semibold text-gray-800 dark:text-gray-100">{item.name}</span>
									<span class="text-gray-500 dark:text-gray-400"> · {item.location}</span>
								</span>
								<span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
									{formatDates(item.startDate, item.endDate)}
								</span>
							</li>
						))}
					</ul>
				</div>
			)
		}
	</div>
</section>

