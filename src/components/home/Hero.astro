---
import { IHeroProps } from "@types";
import { info } from "@data";

const { name, about } = Astro.props as IHeroProps;

// Derive company names from experience (e.g. "Okta - Senior..." -> "Okta")
const companies = info.experience.map((e) => e.name.split(" - ")[0]);
const currentCompany = companies[0];
const previousCompanies = [...new Set(companies.slice(1))].slice(0, 3);
---

<section class="pt-8 sm:pt-16 pb-8 sm:pb-16 relative overflow-hidden">
	<!-- Ambient gradient glow behind the hero -->
	<div class="hero-gradient-bg" aria-hidden="true"></div>

	<div
		class="flex flex-col lg:flex-row items-start justify-between gap-12 mb-12"
	>
		<!-- Left Content -->
		<div class="flex flex-col items-start flex-1">
			<p class="text-gray-600 dark:text-gray-400 text-lg sm:text-xl mb-2 fade-in-up stagger-1">
				Hey, I'm
			</p>
			<h1
				class="mb-4 fade-in-up stagger-2"
			>
				{name}
			</h1>

			<h2
				class="text-2xl sm:text-3xl font-semibold text-gray-800 dark:text-gray-100 mb-8 font-outfit fade-in-up stagger-3"
			>
				{info.jobDescription}
			</h2>

			<!-- CTA Buttons -->
			<div class="flex flex-wrap gap-4 fade-in-up stagger-4">
				<a
					href="#projects"
					class="cta-primary inline-flex items-center px-7 py-3.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white rounded-xl font-medium shadow-lg shadow-blue-500/25"
				>
					View My Work
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="ml-2"
					>
						<path d="M7 17 17 7"></path>
						<path d="m17 7-10 0"></path>
						<path d="m17 7 0 10"></path>
					</svg>
				</a>
				<a
					href="#contact"
					class="inline-flex items-center px-7 py-3.5 border-2 border-blue-500 hover:bg-blue-500 hover:text-white dark:border-blue-400 dark:hover:bg-blue-500 text-blue-600 dark:text-blue-400 rounded-xl font-medium transition-all duration-300"
				>
					Get In Touch
				</a>
			</div>
		</div>

		<!-- Right: Impact panel -->
		<div class="w-full lg:w-[22rem] flex-shrink-0 fade-in-up stagger-3">
			<div class="glass-card rounded-2xl p-6 shadow-lg">
				<!-- Current role -->
				<p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">
					Currently
				</p>
				<p class="text-lg font-semibold text-gray-800 dark:text-gray-100 font-outfit mb-6">
					Senior Engineer <span class="text-blue-500 dark:text-blue-400">@ {currentCompany}</span>
				</p>

				<!-- Previously -->
				<p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">
					Previously
				</p>
				<div class="flex flex-wrap gap-2">
					{
						previousCompanies.map((company) => (
							<span class="px-2.5 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 text-xs font-medium rounded-full">
								{company}
							</span>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Full-width description -->
<div class="w-full fade-in-up stagger-5">
	<p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed max-w-5xl">
		{about}
	</p>
</div>
