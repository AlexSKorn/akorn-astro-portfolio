---
import { formatPostDate, type WritingPost } from "@utils/writing";

interface Props {
	posts: WritingPost[];
}

const { posts } = Astro.props;
---

<ul class="divide-y divide-gray-200 dark:divide-gray-700" role="list">
	{
		posts.map((post) => (
			<li class="py-5 first:pt-0">
				<a href={`/writing/${post.id}/`} class="group block">
					<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
						<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 font-outfit group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors">
							{post.data.title}
						</h3>
						<time
							datetime={post.data.pubDate.toISOString()}
							class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap"
						>
							{formatPostDate(post.data.pubDate)}
						</time>
					</div>
					<p class="mt-1.5 text-gray-600 dark:text-gray-300 leading-relaxed">
						{post.data.description}
					</p>
				</a>
			</li>
		))
	}
</ul>
