---
import { info } from "@data";
import { createLogo } from "@utils";

const linkClass =
	"nav-link px-2 py-3 sm:p-4 block text-sm sm:text-lg transition-colors hover:text-blue-600 dark:text-gray-200 dark:hover:text-blue-400 font-medium";
---

<header
	class="container flex items-center justify-between h-16 sm:h-20 sticky top-0 bg-white/80 dark:bg-[#111111]/80 backdrop-blur-md z-50"
>
	<a
		class="text-2xl text-gray-800 dark:text-gray-100 font-semibold font-outfit"
		href="/"
		aria-label="Go to homepage"
		>{createLogo(info.name)}.
	</a>
	<nav aria-label="Main navigation">
		<ul class="flex items-center">
			<li>
				<a class={linkClass} href="/#experience">Experience</a>
			</li>
			<li>
				<a class={linkClass} href="/#contact">Contact</a>
			</li>
			<li>
				<a
					class={linkClass}
					target="_blank"
					href="/assets/AlexKornResume.pdf"
					aria-label="Resume (PDF, opens in a new tab)"
					rel="noopener noreferrer"
				>
					Resume
				</a>
			</li>
			<li>
				<!-- Both icons are rendered; CSS shows the one matching the current theme -->
				<button
					aria-label="Toggle dark theme"
					id="theme-button"
					type="button"
					class="text-gray-700 dark:text-gray-200 rounded-lg p-3 ml-1 sm:ml-2 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
				>
					<svg
						class="dark:hidden"
						xmlns="http://www.w3.org/2000/svg"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
					</svg>
					<svg
						class="hidden dark:block"
						xmlns="http://www.w3.org/2000/svg"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="5" />
						<path
							d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
						/>
					</svg>
				</button>
			</li>
		</ul>
	</nav>
</header>

<script is:inline>
	(function () {
		const button = document.getElementById("theme-button");
		const themeColor = document.querySelector('meta[name="theme-color"]');
		const apply = (theme) => {
			document.documentElement.setAttribute("data-theme", theme);
			button.setAttribute("aria-pressed", String(theme === "dark"));
			if (themeColor) themeColor.content = theme === "dark" ? "#111111" : "#ffffff";
		};
		apply(document.documentElement.getAttribute("data-theme"));

		button.addEventListener("click", () => {
			const next =
				document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
			apply(next);
			try {
				localStorage.setItem("theme", next);
			} catch (_) {}
		});
	})();
</script>
