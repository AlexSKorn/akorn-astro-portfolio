---
import { render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import MetaHead from "@components/general/MetaHead.astro";
import { formatPostDate, getPosts, type WritingPost } from "@utils/writing";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
	post: WritingPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout>
	<Fragment slot="head">
		<MetaHead
			title={post.data.title}
			description={post.data.description}
			ogImageUrl="/assets/images/astro-portfolio.png"
		/>
	</Fragment>

	<article class="py-10 max-w-3xl">
		<a
			href="/writing/"
			class="text-sm font-medium text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
		>
			← All writing
		</a>
		<header class="mt-6 mb-10">
			<h1 class="text-3xl sm:text-4xl font-semibold text-gray-800 dark:text-gray-100 leading-tight">
				{post.data.title}
			</h1>
			<time
				datetime={post.data.pubDate.toISOString()}
				class="block mt-3 text-sm text-gray-500 dark:text-gray-400"
			>
				{formatPostDate(post.data.pubDate)}
			</time>
		</header>
		<div class="prose prose-gray dark:prose-invert max-w-none prose-headings:font-outfit prose-a:text-blue-600 dark:prose-a:text-blue-400">
			<Content />
		</div>
	</article>
</Layout>
