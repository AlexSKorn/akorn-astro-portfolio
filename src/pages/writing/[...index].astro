---
import Layout from "@layouts/Layout.astro";
import MetaHead from "@components/general/MetaHead.astro";
import WritingList from "@components/general/WritingList.astro";
import { getPosts, type WritingPost } from "@utils/writing";

interface Props {
	posts: WritingPost[];
}

// Only generate /writing/ once at least one post is published
export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.length > 0 ? [{ params: { index: undefined }, props: { posts } }] : [];
}

const { posts } = Astro.props;
---

<Layout>
	<Fragment slot="head">
		<MetaHead
			title="Writing"
			description="Notes on agent identity, distributed systems, and engineering with AI."
			ogImageUrl="/assets/images/astro-portfolio.png"
		/>
	</Fragment>

	<section class="py-10 max-w-3xl" aria-labelledby="writing-title">
		<div class="flex items-center mb-8">
			<div class="section-title-bar mr-4"></div>
			<h1 id="writing-title" class="text-2xl font-semibold text-gray-800 dark:text-gray-100">
				WRITING
			</h1>
		</div>
		<WritingList posts={posts} />
	</section>
</Layout>
