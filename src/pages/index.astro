---

<Layout>
	<Fragment slot="head">
		<MetaHead
			title={"Senior Software Engineer | AI & Distributed Systems"}
			description={"Senior Software Engineer with 8+ years building high-performance distributed systems, cloud platforms, and full-stack products. Currently at Twilio (AI Agent Identity), previously Okta/Auth0. Specializing in TypeScript, Go, React, AWS, Kubernetes, and AI engineering."}
			ogImageUrl={"/assets/images/astro-portfolio.png"}
		/>
	</Fragment>

	<Hero name={info.name} about={info.about} />

	<About />

	{/* TODO: Featured Projects hidden for now — re-enable (along with the
	   ProjectsWrapper import and featureProjects const above) once better
	   projects are ready to display. */}
	{/* <section id="projects" class="my-10" aria-labelledby="projects-title">
		<div class="flex items-center mb-8 fade-in-up">
			<div class="section-title-bar mr-4"></div>
			<h2
				id="projects-title"
				class="text-2xl font-semibold text-gray-800 dark:text-gray-100"
			>
				FEATURED PROJECTS
			</h2>
		</div>
		<ProjectsWrapper projects={featureProjects} />
