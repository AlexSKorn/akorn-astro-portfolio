---
import { info } from "@data";

import Layout from "@layouts/Layout.astro";
import Hero from "@components/home/Hero.astro";
import About from "@components/home/About.astro";
import Experience from "@components/home/Experience.astro";
import Contact from "@components/home/Contact.astro";
import MetaHead from "@components/general/MetaHead.astro";
import Technologies from "@components/home/Technologies.astro";
---

<Layout>
	<Fragment slot="head">
		<MetaHead
			title={"Senior Software Engineer | AI, Identity & Distributed Systems"}
			description={"Senior Software Engineer with 8+ years building high-performance distributed systems, cloud platforms, and full-stack products. Currently at Twilio (AI Agent Identity), previously Okta/Auth0. Specializing in TypeScript, Go, React, AWS, Kubernetes, and AI engineering."}
			ogImageUrl={"/assets/images/og.png"}
		/>
	</Fragment>

	<Hero name={info.name} />

	<About />

	<Experience id="experience" title={"EXPERIENCE"} details={info.experience} detailedCount={3} />

	<Technologies title={"TECHNOLOGIES"} technologies={info.technologies} />
	<Experience id="education" title={"EDUCATION & CERTIFICATIONS"} details={info.education} />

	<Contact />
</Layout>
